{
  "manifest_version": 3,
  "name": "Web Edit",
  "version": "0.1.0",
  "description": "可视化编辑网页与本地 HTML 文件，支持直接写回保存（类 VisBug）",
  "background": { "service_worker": "background/service-worker.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Web Edit — 可视化编辑"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/ns.js",
        "content/history.js",
        "content/ui.js",
        "content/style-panel.js",
        "content/interactions.js",
        "content/saver.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-edit": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "切换可视化编辑模式"
    }
  }
}
